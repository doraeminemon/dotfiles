# fish syntax highlighting, in ANSI slot names only.
#
# The colours come from the terminal theme (Metalterm "phosphor-oklch",
# generated by claude-go-statusline/tools/palette). A slot name here follows
# that theme, so fish, the Starship prompt and the Claude Code statusline
# share one palette. Do not put hex values here: they would not follow it.
#
# Same roles as the Starship prompt: cwd is cyan like its directory, and the
# statusline's directory.

set --global fish_color_normal normal
set --global fish_color_command blue
set --global fish_color_param normal
set --global fish_color_keyword magenta
set --global fish_color_quote green
set --global fish_color_redirection magenta
set --global fish_color_end yellow
set --global fish_color_operator yellow
set --global fish_color_escape brcyan
set --global fish_color_error brred
set --global fish_color_comment brblack
set --global fish_color_autosuggestion brblack
set --global fish_color_valid_path --underline=single
set --global fish_color_cancel --reverse
set --global fish_color_cwd cyan
set --global fish_color_cwd_root red
set --global fish_color_user brgreen
set --global fish_color_host normal
set --global fish_color_host_remote yellow
set --global fish_color_status red
set --global fish_color_history_current --bold
set --global fish_color_search_match --bold --background=black
set --global fish_color_selection --bold --background=black

set --global fish_pager_color_completion normal
set --global fish_pager_color_description yellow
set --global fish_pager_color_prefix normal --bold --underline=single
set --global fish_pager_color_progress brwhite --bold --background=cyan
set --global fish_pager_color_selected_background --background=black
set --global fish_pager_color_selected_completion
set --global fish_pager_color_selected_description
set --global fish_pager_color_selected_prefix
