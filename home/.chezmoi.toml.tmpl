{{- /* The prompt texts "name" and "email" are the keys that `dot` passes with --promptString name=... --promptString email=... */ -}}
{{- $name := promptStringOnce . "name" "name" -}}
{{- $email := promptStringOnce . "email" "email" -}}
# Generated by chezmoi from home/.chezmoi.toml.tmpl. Do not edit by hand.

# The repo checkout root. chezmoi reads .chezmoiroot there, so the source state is <repo>/home.
sourceDir = {{ .chezmoi.workingTree | quote }}

# Plain files become symlinks into the repo. Templates, private, and executable files are still copied.
mode = "symlink"

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
